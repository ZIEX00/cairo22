:root {
  --bg: #f5efe9;
  --bg-deep: #100f13;
  --surface: rgba(255, 255, 255, 0.72);
  --card: rgba(255, 255, 255, 0.82);
  --card-strong: #fffdf9;
  --text: #1f1a17;
  --muted: #685d53;
  --accent: #f0b35d;
  --accent-strong: #d48c2e;
  --accent-dark: #8b5317;
  --gold-soft: #fff0d7;
  --border: rgba(137, 94, 40, 0.18);
  --shadow-soft: 0 22px 50px rgba(28, 24, 19, 0.12);
  --shadow-deep: 0 30px 60px rgba(22, 18, 12, 0.18);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Poppins', 'Segoe UI', Tahoma, sans-serif;
  background:
    radial-gradient(circle at top, rgba(255, 210, 133, 0.32), transparent 28%),
    linear-gradient(180deg, #f9f4ee 0%, #f3e7d8 100%);
  color: var(--text);
  opacity: 0;
  transition: opacity 0.5s ease;
  overflow-x: hidden;
  line-height: 1.6;
}

body.loaded {
  opacity: 1;
}

a {
  text-decoration: none;
}

img {
  display: block;
  max-width: 100%;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 32px;
  background: rgba(16, 15, 19, 0.82);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: 0 12px 28px rgba(19, 15, 10, 0.18);
}

.logo {
  font-size: 30px;
  font-weight: 900;
  letter-spacing: 1px;
  background: linear-gradient(135deg, #f9d490, #d0822a, #fff1cf);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  filter: drop-shadow(0 10px 16px rgba(227, 161, 75, 0.35));
}

.nav-links {
  display: flex;
  gap: 14px;
  align-items: center;
}

.nav-links a {
  color: rgba(255, 255, 255, 0.9);
  font-weight: 700;
  padding: 9px 16px;
  border-radius: 999px;
  transition: all 0.25s ease;
}

.nav-links a:hover {
  background: rgba(240, 179, 93, 0.12);
  color: var(--accent);
  transform: translateY(-1px);
}

.cart-btn, .btn, .checkout-btn, .card button {
  border: none;
  cursor: pointer;
  transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
}

.cart-btn {
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
  color: #fff;
  padding: 11px 18px;
  border-radius: 999px;
  font-weight: 800;
  box-shadow: 0 12px 22px rgba(161, 93, 44, 0.38);
}

.cart-btn:hover, .btn:hover, .checkout-btn:hover, .card button:hover {
  transform: translateY(-2px) scale(1.01);
  filter: brightness(1.04);
}

.hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 46px 20px;
  background:
    linear-gradient(115deg, rgba(10, 10, 10, 0.8), rgba(25, 20, 12, 0.45)),
    url('logo/logo.jpeg') center/cover no-repeat;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  inset: 12% 18% auto auto;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(240, 179, 93, 0.32), transparent 68%);
  filter: blur(10px);
}

.hero::after {
  content: '';
  position: absolute;
  inset: auto auto 8% 12%;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.16), transparent 65%);
  filter: blur(8px);
}

.overlay {
  position: relative;
  z-index: 1;
  width: min(960px, 100%);
  text-align: center;
  color: #fff;
  padding: 46px 34px;
  border-radius: 30px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.04));
  backdrop-filter: blur(10px);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.2), 0 30px 70px rgba(13, 11, 8, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.hero-content h1 {
  font-size: clamp(28px, 4vw, 54px);
  margin: 0 0 18px;
  font-weight: 900;
  line-height: 1.2;
  color: #fff;
}

.hero-content p {
  font-size: 18px;
  color: rgba(253, 242, 225, 0.92);
  margin-bottom: 28px;
}

.hero-actions {
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
}

.btn {
  display: inline-block;
  padding: 14px 28px;
  border-radius: 999px;
  font-weight: 800;
  letter-spacing: 0.2px;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
  color: #fff;
  box-shadow: 0 16px 30px rgba(156, 111, 43, 0.32);
}

.btn-secondary {
  background: rgba(255,255,255,0.1);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.15);
}

.stats,
.benefits,
.testimonial-cards,
.about-cards {
  display: grid;
  gap: 22px;
}

.stats {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  max-width: 1100px;
  margin: 0 auto;
  padding: 26px 20px 0;
}

.stat-card,
.benefit-card,
.testimonial-card,
.card-about,
.card {
  position: relative;
  border-radius: 24px;
  background: linear-gradient(180deg, rgba(255,255,255,0.94), rgba(255,255,255,0.78));
  border: 1px solid var(--border);
  box-shadow: var(--shadow-soft);
  transform-style: preserve-3d;
}

.stat-card {
  padding: 24px 18px;
  text-align: center;
  background: linear-gradient(180deg, #fffaf3, rgba(255,255,255,0.82));
}

.stat-card h3 {
  color: var(--accent-dark);
  font-size: 25px;
  margin: 0 0 6px;
}

.section-heading {
  text-align: center;
  margin-bottom: 24px;
}

.section-heading h2,
.about-content h2,
.cta h2 {
  font-size: clamp(28px, 3vw, 38px);
  margin-bottom: 10px;
  color: var(--text);
}

.section-heading p,
.about-content p,
.cta p {
  color: var(--muted);
  margin: 0;
}

.products {
  max-width: 1200px;
  margin: 0 auto;
  padding: 58px 20px 40px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 24px;
}

.card {
  padding: 16px;
  text-align: center;
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  overflow: hidden;
}

.card:hover {
  box-shadow: var(--shadow-deep);
  border-color: rgba(212, 140, 46, 0.26);
}

.card img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 18px;
  border: 1px solid rgba(27, 22, 17, 0.06);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.2);
}

.card h3 {
  color: var(--text);
  margin: 14px 0 8px;
  font-size: 18px;
  min-height: 48px;
}

.card p {
  margin: 6px 0 14px;
  color: var(--accent-dark);
  font-weight: 800;
  font-size: 17px;
}

.card button {
  width: 100%;
  margin-bottom: 10px;
  border-radius: 999px;
  padding: 10px 12px;
  font-weight: 800;
  box-shadow: 0 8px 18px rgba(17, 17, 17, 0.08);
}

.card button:first-of-type {
  background: #111;
  color: #fff;
}

.card button:nth-of-type(2) {
  background: #f8efe5;
  color: var(--text);
}

.card button:nth-of-type(3) {
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
  color: #fff;
}

.about {
  max-width: 1100px;
  margin: 0 auto;
  padding: 64px 20px 15px;
}

.about-cards,
.benefits {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 26px;
}

.card-about,
.benefit-card {
  padding: 26px 22px;
  background: linear-gradient(180deg, rgba(255,255,255,0.88), rgba(255,255,255,0.76));
}

.card-about h3,
.benefit-card h3 {
  color: var(--accent-dark);
  margin-top: 0;
  font-size: 22px;
}

.testimonials {
  max-width: 1100px;
  margin: 0 auto;
  padding: 64px 20px 40px;
}

.testimonial-cards {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.testimonial-card {
  padding: 24px 22px;
}

.testimonial-card p {
  color: var(--muted);
  font-size: 16px;
}

.testimonial-card h4 {
  color: var(--accent-dark);
  margin: 18px 0 0;
  font-size: 20px;
}

.cta {
  text-align: center;
  padding: 36px 20px 64px;
}

.cta h2 {
  margin-bottom: 10px;
}

.footer {
  background: linear-gradient(180deg, #111214, #0d0d11);
  color: #f2ece5;
  padding: 44px 20px 26px;
}

.footer-container {
  display: flex;
  justify-content: space-between;
  gap: 28px;
  flex-wrap: wrap;
  max-width: 1100px;
  margin: 0 auto;
}

.footer-col {
  flex: 1;
  min-width: 220px;
}

.footer-col h3 {
  color: var(--accent);
  margin-bottom: 12px;
}

.footer-col a,
.footer-col p,
.socials a {
  color: rgba(255,255,255,0.75);
}

.footer-col ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-col ul li {
  margin-bottom: 10px;
}

.copyright {
  text-align: center;
  margin-top: 24px;
  color: rgba(255,255,255,0.55);
}

.cart-sidebar {
  position: fixed;
  top: 0;
  right: -360px;
  width: 320px;
  height: 100%;
  background: linear-gradient(180deg, rgba(18, 18, 20, 0.98), rgba(10, 10, 12, 0.98));
  color: #fff;
  padding: 20px;
  transition: right 0.35s ease;
  z-index: 1000;
  box-shadow: -10px 0 25px rgba(0,0,0,0.22);
  border-left: 1px solid rgba(255,255,255,0.06);
}

.cart-sidebar.active {
  right: 0;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 14px;
  padding: 10px 12px;
  margin-bottom: 10px;
}

.cart-actions {
  display: flex;
  gap: 6px;
}

.cart-actions button {
  border: none;
  width: 30px;
  height: 30px;
  border-radius: 8px;
  cursor: pointer;
}

.cart-actions button:nth-child(1) { background: #f3b04f; }
.cart-actions button:nth-child(2) { background: #2fb67d; }
.cart-actions button:nth-child(3) { background: #f24b4b; color: #fff; }

.cart-footer {
  margin-top: 12px;
  border-top: 1px solid rgba(255,255,255,0.08);
  padding-top: 12px;
}

.checkout-btn {
  width: 100%;
  border: none;
  border-radius: 999px;
  padding: 12px;
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
  color: #fff;
  font-weight: 800;
  box-shadow: 0 16px 26px rgba(166, 116, 53, 0.28);
}

.toast {
  position: fixed;
  bottom: 22px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(17, 17, 17, 0.92);
  color: #fff;
  padding: 12px 18px;
  border-radius: 999px;
  z-index: 9999;
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
  animation: fadeInOut 3s ease;
}

#loader {
  position: fixed;
  inset: 0;
  background: linear-gradient(180deg, #fffaf5, #f6efe8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.spinner {
  border: 6px solid rgba(214, 160, 90, 0.2);
  border-top: 6px solid var(--accent-dark);
  border-radius: 50%;
  width: 58px;
  height: 58px;
  animation: spin 1s linear infinite;
  box-shadow: 0 8px 18px rgba(179, 112, 36, 0.15);
}

.fade-in {
  opacity: 0;
  transform: translateY(20px);
  transition: all 0.8s ease-out;
}

.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

#typing-text::after {
  content: '|';
  animation: blink 1s infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

@keyframes fadeInOut {
  0% { opacity: 0; transform: translate(-50%, 18px); }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { opacity: 0; transform: translate(-50%, 0); }
}

@media (max-width: 900px) {
  .stats,
  .about-cards,
  .benefits,
  .testimonial-cards {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  header {
    flex-direction: column;
    gap: 10px;
    padding: 16px;
  }

  .nav-links {
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero {
    min-height: 80vh;
  }

  .overlay {
    padding: 26px 20px;
  }

  .grid {
    grid-template-columns: 1fr;
  }

  .cart-sidebar {
    width: 100%;
  }
}

@media (max-width: 550px) {
  header {
    padding: 14px 12px;
  }

  .cart-sidebar {
    width: 100%;
    right: -100%;
    left: 0;
    top: 0;
    height: 100vh;
    border-radius: 0;
    padding: 20px 16px;
    max-width: none;
  }

  .cart-sidebar.active {
    right: 0;
  }

  .cart-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .cart-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .cart-actions {
    width: 100%;
    justify-content: flex-start;
    gap: 8px;
  }

  .cart-actions button {
    width: auto;
    min-width: 46px;
  }

  .checkout-btn {
    padding: 14px;
  }

  .logo {
    font-size: 24px;
  }

  .hero {
    min-height: 70vh;
    padding: 24px 12px;
  }

  .overlay {
    padding: 18px;
  }

  .hero-content h1 {
    font-size: clamp(24px, 8vw, 36px);
  }

  .hero-content p {
    font-size: 16px;
  }

  .hero-actions {
    flex-direction: column;
  }

  .btn {
    width: 100%;
    text-align: center;
  }
}
